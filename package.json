{
  "name": "doalink",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:css": "npx @tailwindcss/cli -i src/styles.css -o src/styles.generated.css --minify",
    "config": "node scripts/gerar-config.mjs",
    "start": "node scripts/gerar-config.mjs && npx @tailwindcss/cli -i src/styles.css -o src/styles.generated.css --watch & ng serve",
    "build": "node scripts/gerar-config.mjs && npx @tailwindcss/cli -i src/styles.css -o src/styles.generated.css --minify && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-cli-ghpages": "^3.1.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2"
  }
}
