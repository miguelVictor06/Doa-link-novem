{
  "name": "doalink-backend",
  "version": "1.0.0",
  "description": "Backend API para o DoaLink",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrar-sqlite.js",
    "migrar:arquivos": "node --env-file-if-exists=.env scripts/migrar-arquivos-cloudinary.js",
    "backup": "node --env-file-if-exists=.env scripts/backup-sqlite.js",
    "test:integracao": "node --env-file-if-exists=.env test/integracao.js",
    "test:cloudinary": "node --env-file-if-exists=.env test/cloudinary.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  }
}
