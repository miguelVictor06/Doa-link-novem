# Ambiente
NODE_ENV=development
PORT=8080

# PostgreSQL/Neon
DATABASE_URL=postgres://usuario:senha@localhost:5432/doalink
# Use "require" no Neon; "disable" em PostgreSQL local e no Render Postgres interno.
PGSSL=disable
# Em produção com certificado válido, use true.
PGSSL_REJECT_UNAUTHORIZED=false

# HTTP
CORS_ORIGINS=http://localhost:4200
PUBLIC_API_URL=http://localhost:8080

# Sessão
SESSION_COOKIE_NAME=doalink_sessao
SESSION_TTL_HOURS=168
# SESSION_COOKIE_DOMAIN=

# Segurança
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=600

# Pool PostgreSQL
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=10000

# Cloudinary (obrigatório para uploads de fotos)
CLOUDINARY_CLOUD_NAME=rkt3v3ug
CLOUDINARY_API_KEY=546977238399252
CLOUDINARY_API_SECRET=OesuXmcF3_ZtTTZ4jhGVqORthl8
CLOUDINARY_FOLDER=doalink
# Opcional, apenas para testes locais com servidor fake HTTPS:
# CLOUDINARY_UPLOAD_PREFIX=https://127.0.0.1:9090
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Migração SQLite -> PostgreSQL
# PERMITIR_MIGRACAO_SOBRE_DADOS=true
